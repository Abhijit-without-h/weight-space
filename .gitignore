# Research notes stay local; only the root README is published.
*.md
!/README.md
/notes/

# Model weights are never committed, including generated policy artifacts.
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.onnx
*.npz
*.bin

# The website is maintained locally for a separate private repository.
/web/
